# =============================================
# LiteLLM 設定（助教提供，用於 Chat Completion）
# =============================================
LITELLM_API_KEY=your_api_key_here
LITELLM_BASE_URL=https://litellm.netdb.csie.ncku.edu.tw

# =============================================
# Embedding Model 設定
# =============================================
# 使用 sentence-transformers 本地模型（完全免費，無需 API Key）
# 英文論文資料使用 all-MiniLM-L6-v2（80MB，速度快）
# 首次執行自動從 HuggingFace 下載，之後完全離線
EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================
# Vector DB 設定（ChromaDB，純 Python，無需 Docker）
# =============================================
CHROMA_PERSIST_DIR=./chroma_db

# =============================================
# RAG 參數
# =============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
DEFAULT_LLM_MODEL=gemini-2.5-flash
